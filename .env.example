# Copy into a private .env; production values come from the corporate secret manager.
NODE_ENV=development
DATABASE_URL=postgresql://panel:local-only-change-me@localhost:5432/panel?schema=public
TEST_DATABASE_URL=postgresql://panel:local-only-change-me@localhost:5432/panel_test
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000
OIDC_ISSUER=https://keycloak.example.invalid/realms/REPLACE_ME
OIDC_CLIENT_ID=REPLACE_ME_WEB_CLIENT
OIDC_CLIENT_SECRET=
OIDC_API_AUDIENCE=REPLACE_ME_API_AUDIENCE
# Enable introspection in corporate production; grant the API client permission in Keycloak.
OIDC_INTROSPECTION_ENABLED=false
OIDC_INTROSPECTION_CLIENT_ID=
OIDC_INTROSPECTION_CLIENT_SECRET=
ACCESS_MAPPING_FILE=./config/access-mapping.json
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=
MAIL_ENABLED=false
MAIL_ALLOWED_DOMAINS=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
