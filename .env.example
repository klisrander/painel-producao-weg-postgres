# Preencher com a TI. Nenhum valor abaixo é credencial de produção.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://CHANGE_ME.example.test
DATABASE_URL=postgresql://panel:CHANGE_ME@postgres:5432/panel
POSTGRES_PASSWORD=CHANGE_ME
OIDC_ISSUER=https://CHANGE_ME.example.test/realms/CHANGE_ME
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
# CA corporativa para PostgreSQL, se necessária (caminho de arquivo PEM):
# PGSSLROOTCERT=/run/config/postgres-ca.pem
# Catálogos e metas históricas exportados privadamente do repositório original:
# EQUIPMENT_CATALOG_FILE=/run/config/equipment-catalog.json
# ASSEMBLY_CATALOG_FILE=/run/config/assembly-catalog.json
# BASELINE_GOALS_FILE=/run/config/baseline-goals.json
# Somente desenvolvimento local: NODE_ENV=development, HTTP em localhost,
# ALLOW_HTTP_LOOPBACK=true. Nunca habilitar em produção.
