{
  "name": "painel-producao-weg-postgres",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "user:provision": "node scripts/provision-user.mjs",
    "data:import": "node scripts/import-backup.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/*.integration.mjs"
  },
  "dependencies": {
    "jose": "6.2.18",
    "openid-client": "6.9.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.15",
    "tsx": "4.23.15"
  }
}
