{
  "name": "@panel/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/*.integration.ts",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/client": "6.19.3",
    "@panel/contracts": "file:../../packages/contracts",
    "@panel/domain": "file:../../packages/domain",
    "jose": "6.2.18",
    "luxon": "3.7.2",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "22.19.19",
    "@types/luxon": "3.7.1",
    "@types/nodemailer": "7.0.4",
    "@types/express": "5.0.5",
    "prisma": "6.19.3"
  }
}
